# ─────────────────────────────────────────────────────────────────────────────
# Rock Island Nursing Home — environment variables
# Copy to .env.local for local development; set in your host (e.g., Vercel) for production.
# NEXT_PUBLIC_* values are exposed to the browser. Never put secrets in them.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical domain (used for canonical URLs, sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://rockislandnursinghome.com

# Pre-launch markers ("Pending verification" badges, photo labels, preview notice,
# sample testimonials). Set to false ONLY after all content has been verified.
NEXT_PUBLIC_SHOW_VERIFICATION_FLAGS=true

# Set to true on staging/preview deployments to block search engine indexing.
NEXT_PUBLIC_NOINDEX=false

# ── Form delivery (choose one) ───────────────────────────────────────────────
# Option A: Email via Resend (https://resend.com). Verify the sending domain first.
RESEND_API_KEY=
FORMS_FROM_EMAIL="Rock Island Nursing Home Website <website@rockislandnursinghome.com>"
# Option B: Webhook to a CRM/automation platform (JSON POST)
FORMS_WEBHOOK_URL=
FORMS_WEBHOOK_SECRET=

# Recipients (comma-separated). Form-specific values override the default.
FORMS_TO_DEFAULT=
FORMS_TO_CONTACT=
FORMS_TO_TOUR=
FORMS_TO_ADMISSIONS=
FORMS_TO_REFERRAL=
FORMS_TO_CAREERS=

# ── Spam protection (optional, recommended) — Cloudflare Turnstile ───────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Analytics (optional) — use GTM (preferred) OR GA4 directly ───────────────
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
# Google Search Console HTML-tag verification token (content value only)
NEXT_PUBLIC_GSC_VERIFICATION=

# ── Third-party integrations (optional) ──────────────────────────────────────
# Secure e-referral platform URL for hospitals (shows "Open Secure Portal")
NEXT_PUBLIC_SECURE_REFERRAL_URL=
# Applicant tracking system careers page (View Open Positions / Apply Now link out)
NEXT_PUBLIC_ATS_URL=
# Online tour scheduler, e.g. Calendly (shows "Book online")
NEXT_PUBLIC_TOUR_SCHEDULER_URL=
